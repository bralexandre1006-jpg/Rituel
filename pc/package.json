{
  "name": "rituel-pc",
  "productName": "Rituel",
  "version": "1.1.0",
  "description": "Widgets de bureau Rituel, synchronisés avec le téléphone",
  "author": "Rituel",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "be.brun.rituel.pc",
    "productName": "Rituel",
    "files": [
      "main.js",
      "preload.js",
      "widget.html",
      "widget.css",
      "app.html",
      "app.css",
      "app.js",
      "core.js",
      "ui.js",
      "datepick.js",
      "add.html",
      "add.js",
      "config.js",
      "fonts.css",
      "icon.png",
      "icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Rituel",
      "runAfterFinish": true,
      "artifactName": "Rituel-PC-Setup.${ext}"
    }
  }
}